rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId);
      
      // Notifications Subcollection
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
      }
    }

    // Posts Collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated(); // For likes
      allow delete: if isOwner(resource.data.userId);
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        get(/databases/$(database)/documents/posts/$(resource.data.postId)).data.userId == request.auth.uid
      );
    }

    // Saved Posts Collection
    match /savedPosts/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Chats Collection (Optimized for Participant Security)
    match /chats/{chatId} {
      // Allow read if you are a participant
      allow get: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow list: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Allow creation if the creator is one of the participants
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participants;
      
      // Allow updates if you are a participant (for lastMessage, etc)
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Messages Subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants ||
          request.auth.uid == request.resource.data.senderId
        );
      }
    }

    // Stories Collection
    match /stories/{storyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default lockdown
    match /{document=**} {
      allow read, write: if false; 
    }
  }
}